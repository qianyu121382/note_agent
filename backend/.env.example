OPENAI_API_KEY=sk-...
LANGSMITH_API_KEY=lsv2...
LANGSMITH_PROJECT=note-agent

# LangGraph API persistence database for thread-scoped short-term memory.
# Example:
# POSTGRES_URI=postgresql://postgres:your_password@127.0.0.1:5432/note_agent
POSTGRES_URI=postgresql://postgres:your_password@127.0.0.1:5432/note_agent
# Local persistent Qdrant store for note chunk vectors.
QDRANT_PATH=backend/data/qdrant
QDRANT_COLLECTION=note_chunks
EMBEDDING_MODEL=text-embedding-3-small
